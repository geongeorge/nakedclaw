{
  model: {
    provider: 'openrouter',
    name: 'nvidia/nemotron-3-super-120b-a12b:free',
  },
  workspace: '/home/mapple/nakedclaw',
  channels: {
    telegram: {
      enabled: false,
      allowFrom: [],
    },
    whatsapp: {
      enabled: false,
      allowFrom: [],
    },
    slack: {
      enabled: false,
      allowFrom: [],
    },
  },
  sessions: {
    dir: './sessions',
    maxTurns: 50,
  },
  memory: {
    dir: './memory',
    indexFile: './memory/temporary-memory.md',
  },
  brain: {
    dir: './brain',
  },
  heartbeat: {
    enabled: false,
    cronExpr: '0 * * * *',
  },
  skills: {
    dir: './skills',
    autoSync: true,
  },
}
